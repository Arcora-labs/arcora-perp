2026-10-14T14:20:25.6517398Z {"database":{"advisory-count":1314,"last-commit":"caee11f41fab07d676c0a4655a2a5dd1f94da97c","last-updated":"2026-10-14T15:17:45+02:00"},"lockfile":{"dependency-count":262},"settings":{"target_arch":[],"target_os":[],"severity":null,"ignore":[],"informational_warnings":["unmaintained","unsound","notice"]},"vulnerabilities":{"found":true,"count":4,"list":[{"advisory":{"id":"RUSTSEC-2026-0347","package":"rustls","title":"Buffered application data sent to outer server after ECH rejection","description":"When a server rejects Encrypted Client Hello (ECH), the client completes the\nhandshake using the outer ClientHello and authenticates the server against the\nECH config's `public_name`. At the end of that handshake, rustls encrypted and\nqueued any application data buffered via `ClientConnection::writer()` *before*\nqueueing the `ech_required` alert.\n\nThe application correctly receives\n`Error::PeerIncompatible(ServerRejectedEncryptedClientHello)`, but the next\n`write_tls()` call (needed to send the alert) also sends the buffered\napplication data. Plaintext meant for the inner server therefore goes to the\nclient-facing server named by `public_name`.\n\nThat server is authenticated, so this is not exploitable by an unauthenticated\nparty, but it violates RFC 9849 section 6.1.6, which requires the client to\nabort with `ech_required` \"before sending any application data to the server\".\n\nThis affects only clients that:\n\n- use `EchMode::Enable` (GREASE ECH is not affected),\n- write application data before the handshake completes, and\n- connect to a server that rejects their ECH config (for example, because it is stale).\n\nThe underlying ordering bug is older, but before 0.23.44 the client checked\nthe server certificate against the inner server name rather than `public_name`,\nso certificate verification failed first and no data was sent.","date":"2026-10-14","aliases":["GHSA-vp88-798v-h67f"],"related":[],"collection":"crates","categories":["crypto-failure"],"keywords":[],"cvss":"CVSS:3.1/AV:L/AC:L/PR:H/UI:N/S:U/C:L/I:N/A:N","informational":null,"references":[],"source":null,"url":"https://github.com/rustls/rustls/pull/3300","withdrawn":null,"license":"CC0-1.0","expect-deleted":false},"versions":{"patched":[">=0.23.46"],"unaffected":["<0.23.44"]},"affected":null,"package":{"name":"rustls","version":"0.23.45","source":"registry+https://github.com/rust-lang/crates.io-index","checksum":"0d41d731c7d2f962d1ccc364cec258de3c0e93b38c2fb3ba97ac74513048d634","dependencies":[{"name":"log","version":"0.4.33","source":"registry+https://github.com/rust-lang/crates.io-index"},{"name":"once_cell","version":"1.21.4","source":"registry+https://github.com/rust-lang/crates.io-index"},{"name":"ring","version":"0.17.14","source":"registry+https://github.com/rust-lang/crates.io-index"},{"name":"rustls-pki-types","version":"1.14.1","source":"registry+https://github.com/rust-lang/crates.io-index"},{"name":"rustls-webpki","version":"0.103.15","source":"registry+https://github.com/rust-lang/crates.io-index"},{"name":"subtle","version":"2.6.1","source":"registry+https://github.com/rust-lang/crates.io-index"},{"name":"zeroize","version":"1.9.0","source":"registry+https://github.com/rust-lang/crates.io-index"}],"replace":null}},{"advisory":{"id":"RUSTSEC-2026-0348","package":"rustls","title":"Brotli certificate decompression can allocate up to 1 GiB before authentication","description":"The built-in Brotli certificate decompressor (enabled by the non-default\n`brotli` crate feature) bounded the size of the decompressed output, but\naccepted a peer-selected history window. Brotli's large-window extension was\nenabled, so a five-byte header could cause an allocation of 1 GiB. A peer can\nabort a process whose allocator cannot satisfy that request.\n\nNo trusted certificate is required by the attacker. Affected configurations are:\n\n- clients that enable the `brotli` feature and connect to a malicious server, and\n- servers that enable the `brotli` feature and request client certificates.\n\nApplications that do not enable the `brotli` feature are not affected.","date":"2026-10-14","aliases":["GHSA-h2v8-394m-p7vv"],"related":[],"collection":"crates","categories":["denial-of-service"],"keywords":[],"cvss":"CVSS:3.1/AV:N/AC:H/PR:N/UI:N/S:U/C:N/I:N/A:L","informational":null,"references":[],"source":null,"url":"https://github.com/rustls/rustls/pull/3297","withdrawn":null,"license":"CC0-1.0","expect-deleted":false},"versions":{"patched":[">=0.23.46"],"unaffected":["<0.23.9"]},"affected":null,"package":{"name":"rustls","version":"0.23.45","source":"registry+https://github.com/rust-lang/crates.io-index","checksum":"0d41d731c7d2f962d1ccc364cec258de3c0e93b38c2fb3ba97ac74513048d634","dependencies":[{"name":"log","version":"0.4.33","source":"registry+https://github.com/rust-lang/crates.io-index"},{"name":"once_cell","version":"1.21.4","source":"registry+https://github.com/rust-lang/crates.io-index"},{"name":"ring","version":"0.17.14","source":"registry+https://github.com/rust-lang/crates.io-index"},{"name":"rustls-pki-types","version":"1.14.1","source":"registry+https://github.com/rust-lang/crates.io-index"},{"name":"rustls-webpki","version":"0.103.15","source":"registry+https://github.com/rust-lang/crates.io-index"},{"name":"subtle","version":"2.6.1","source":"registry+https://github.com/rust-lang/crates.io-index"},{"name":"zeroize","version":"1.9.0","source":"registry+https://github.com/rust-lang/crates.io-index"}],"replace":null}},{"advisory":{"id":"RUSTSEC-2026-0349","package":"rustls","title":"Unauthenticated ServerHello can downgrade later connections to classical key exchange","description":"The client recorded the server-selected key exchange group for each server\nname when processing the ServerHello, before the server was authenticated.\nThis record is used to predict which key share to send in future ClientHellos\nto that server name.\n\nA network attacker can answer one connection attempt with a ServerHello\nselecting X25519, and then close the connection. Later ClientHellos for that\nname carry only an X25519 key share, while `supported_groups` still lists\nX25519MLKEM768 first. If the genuine server accepts that share rather than\nsending a HelloRetryRequest for its preferred hybrid group, the handshake\ncompletes with classical-only key exchange and no error. This persists for as\nlong as the entry stays in the client's session store.\n\nThe impact is loss of post-quantum confidentiality for affected connections\n(\"harvest now, decrypt later\"). There is no key compromise and no\nauthentication bypass.\n\nThe following are not affected:\n\n- connections to servers which send a HelloRetryRequest for their preferred group,\n- clients with resumption disabled (as nothing is stored), and\n- other server names.\n\nThis behaviour is discussed in\n[draft-ietf-tls-key-share-prediction](https://www.ietf.org/archive/id/draft-ietf-tls-key-share-prediction-01.html#name-security-considerations),\nso the practical impact depends largely on server policy.","date":"2026-10-14","aliases":["GHSA-w44r-93j7-qv28"],"related":[],"collection":"crates","categories":["crypto-failure"],"keywords":[],"cvss":"CVSS:3.1/AV:N/AC:H/PR:N/UI:N/S:U/C:L/I:N/A:N","informational":null,"references":[],"source":null,"url":"https://github.com/rustls/rustls/pull/3355","withdrawn":null,"license":"CC0-1.0","expect-deleted":false},"versions":{"patched":[">=0.23.46"],"unaffected":[]},"affected":null,"package":{"name":"rustls","version":"0.23.45","source":"registry+https://github.com/rust-lang/crates.io-index","checksum":"0d41d731c7d2f962d1ccc364cec258de3c0e93b38c2fb3ba97ac74513048d634","dependencies":[{"name":"log","version":"0.4.33","source":"registry+https://github.com/rust-lang/crates.io-index"},{"name":"once_cell","version":"1.21.4","source":"registry+https://github.com/rust-lang/crates.io-index"},{"name":"ring","version":"0.17.14","source":"registry+https://github.com/rust-lang/crates.io-index"},{"name":"rustls-pki-types","version":"1.14.1","source":"registry+https://github.com/rust-lang/crates.io-index"},{"name":"rustls-webpki","version":"0.103.15","source":"registry+https://github.com/rust-lang/crates.io-index"},{"name":"subtle","version":"2.6.1","source":"registry+https://github.com/rust-lang/crates.io-index"},{"name":"zeroize","version":"1.9.0","source":"registry+https://github.com/rust-lang/crates.io-index"}],"replace":null}},{"advisory":{"id":"RUSTSEC-2026-0346","package":"rustls","title":"`Debug` impls for client session values expose TLS secrets","description":"The `Debug` implementations of `Tls12ClientSessionValue` and\n`Tls13ClientSessionValue` were derived, and so included the TLS 1.2 master\nsecret or TLS 1.3 resumption PSK in their output.\n\nCustom `ClientSessionStore` implementations that format these values with\n`Debug` (for example, when logging) could disclose these secrets to readers of\nthe logs. This conflicts with rustls's\n[key-material redaction policy](https://github.com/rustls/rustls/blob/99f2358cae2954837dbb866faf6727de75489ab9/SECURITY.md#boundary-public-api).\n\nOrdinary connection and built-in session cache `Debug` output is redacted and\nis not affected.","date":"2026-10-14","aliases":["GHSA-c8m5-c952-6cm4"],"related":[],"collection":"crates","categories":["crypto-failure"],"keywords":[],"cvss":"CVSS:3.1/AV:L/AC:H/PR:H/UI:R/S:U/C:H/I:N/A:N","informational":null,"references":[],"source":null,"url":"https://github.com/rustls/rustls/pull/3299","withdrawn":null,"license":"CC0-1.0","expect-deleted":false},"versions":{"patched":[">=0.23.46"],"unaffected":["<0.21.0"]},"affected":null,"package":{"name":"rustls","version":"0.23.45","source":"registry+https://github.com/rust-lang/crates.io-index","checksum":"0d41d731c7d2f962d1ccc364cec258de3c0e93b38c2fb3ba97ac74513048d634","dependencies":[{"name":"log","version":"0.4.33","source":"registry+https://github.com/rust-lang/crates.io-index"},{"name":"once_cell","version":"1.21.4","source":"registry+https://github.com/rust-lang/crates.io-index"},{"name":"ring","version":"0.17.14","source":"registry+https://github.com/rust-lang/crates.io-index"},{"name":"rustls-pki-types","version":"1.14.1","source":"registry+https://github.com/rust-lang/crates.io-index"},{"name":"rustls-webpki","version":"0.103.15","source":"registry+https://github.com/rust-lang/crates.io-index"},{"name":"subtle","version":"2.6.1","source":"registry+https://github.com/rust-lang/crates.io-index"},{"name":"zeroize","version":"1.9.0","source":"registry+https://github.com/rust-lang/crates.io-index"}],"replace":null}}]},"warnings":{"unmaintained":[{"kind":"unmaintained","package":{"name":"atomic-polyfill","version":"1.0.3","source":"registry+https://github.com/rust-lang/crates.io-index","checksum":"8cf2bce30dfe09ef0bfaef228b9d414faaf7e563035494d7fe092dba54b300f4","dependencies":[{"name":"critical-section","version":"1.2.0","source":"registry+https://github.com/rust-lang/crates.io-index"}],"replace":null},"advisory":{"id":"RUSTSEC-2023-0089","package":"atomic-polyfill","title":"atomic-polyfill is unmaintained","description":"The author has archived the GitHub repository and mentions deprecation in\nproject's\n[README](https://github.com/embassy-rs/atomic-polyfill/blob/48e55c166684f37af0b00fbee5a0809b1a2bae8e/README.md).\n\n## Possible alternatives\n\n * [portable-atomic](https://crates.io/crates/portable-atomic)","date":"2023-07-11","aliases":[],"related":[],"collection":"crates","categories":[],"keywords":[],"cvss":null,"informational":"unmaintained","references":[],"source":null,"url":"https://github.com/embassy-rs/atomic-polyfill/commit/48e55c166684f37af0b00fbee5a0809b1a2bae8e","withdrawn":null,"license":"CC0-1.0","expect-deleted":false},"affected":null,"versions":{"patched":[],"unaffected":[]}}],"yanked":[{"kind":"yanked","package":{"name":"spin","version":"0.9.8","source":"registry+https://github.com/rust-lang/crates.io-index","checksum":"6980e8d7511241f8acf4aebddbb1ff938