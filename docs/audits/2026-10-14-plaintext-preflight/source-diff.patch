+/// Invert the same monotonic sealed/hex/JSON expansion, without a new policy cap.
+/// The upper bound is safe even for usize::MAX; an overflowing expansion cannot fit.
+fn plaintext_byte_limit(body_limit: usize) -> Result<usize, crate::curl_transport::Error> {
+    crate::curl_transport::check_request_body_bytes(sealed_request_json_bytes(0)?, body_limit)?;
+    let (mut low, mut high) = (0usize, body_limit / 2);
+    while low < high {
+        let middle = low + (high - low) / 2 + 1;
+        if sealed_request_json_bytes(middle).is_ok_and(|bytes| bytes <= body_limit) {
+            low = middle;
+        } else {
+            high = middle - 1;
+        }
+    }
+    Ok(low)
+}
+
+struct PlaintextCount {
+    used: usize,
+    limit: usize,
+    exceeded: bool,
+}
+
+impl PlaintextCount {
+    fn add(&mut self, bytes: usize) -> postcard::Result<()> {
+        match self
+            .used
+            .checked_add(bytes)
+            .filter(|used| *used <= self.limit)
+        {
+            Some(used) => {
+                self.used = used;
+                Ok(())
+            }
+            None => {
+                self.exceeded = true;
+                Err(postcard::Error::SerializeBufferFull)
+            }
+        }
+    }
+}
+
+impl postcard::ser_flavors::Flavor for &mut PlaintextCount {
+    type Output = usize;
+
+    fn try_push(&mut self, _byte: u8) -> postcard::Result<()> {
+        self.add(1)
+    }
+
+    fn try_extend(&mut self, bytes: &[u8]) -> postcard::Result<()> {
+        self.add(bytes.len())
+    }
+
+    fn finalize(self) -> postcard::Result<usize> {
+        Ok(self.used)
+    }
+}
+
+/// Private seam for the known immutable witness tuples. Counting creates no
+/// output buffer; arbitrary Serialize implementations may still allocate or drift.
+fn encode_plaintext_with_body_limit<T: serde::Serialize + ?Sized>(
+    value: &T,
+    prefix: &[u8],
+    body_limit: usize,
+) -> Result<Vec<u8>, ProverClientError> {
+    preflight_then_encode_plaintext(value, prefix, body_limit, || postcard::to_allocvec(value))
+}
+
+fn preflight_then_encode_plaintext<T, F>(
+    value: &T,
+    prefix: &[u8],
+    body_limit: usize,
+    encode: F,
+) -> Result<Vec<u8>, ProverClientError>
+where
+    T: serde::Serialize + ?Sized,
+    F: FnOnce() -> postcard::Result<Vec<u8>>,
+{
+    let limit =
+        plaintext_byte_limit(body_limit).map_err(|e| ProverClientError::Http(e.to_string()))?;
+    if prefix.len() > limit {
+        return Err(ProverClientError::Http(
+            crate::curl_transport::Error::RequestBodyLimit.to_string(),
+        ));
+    }
+    let mut counter = PlaintextCount {
+        used: prefix.len(),
+        limit,
+        exceeded: false,
+    };
+    let counted = postcard::serialize_with_flavor(value, &mut counter).map_err(|e| {
+        if counter.exceeded {
+            ProverClientError::Http(crate::curl_transport::Error::RequestBodyLimit.to_string())
+        } else {
+            ProverClientError::Decode(format!("witness encode: {e}"))
+        }
+    })?;
+    let body = encode().map_err(|e| ProverClientError::Decode(format!("witness encode: {e}")))?;
+    let bytes = if prefix.is_empty() {
+        body
+    } else {
+        let mut bytes = prefix.to_vec();
+        bytes.extend(body);
+        bytes
+    };
+    // Length drift is caught after allocation; same-length content drift is not.
+    // Only the fixed borrowed witness types have the pre-allocation size guarantee.
+    if bytes.len() != counted {
+        return Err(ProverClientError::Decode(
+            "witness encoded size changed".into(),
+        ));
+    }
+    Ok(bytes)
+}
