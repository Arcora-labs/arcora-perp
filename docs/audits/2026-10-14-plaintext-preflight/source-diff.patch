+    #[test]
+    fn prefix_refusal_precedes_traversal_and_count_stops_early() {
+        struct Traced<'a> {
+            bytes: &'a [u8],
+            visits: &'a Cell<usize>,
+        }
+        impl serde::Serialize for Traced<'_> {
+            fn serialize<S: serde::Serializer>(&self, serializer: S) -> Result<S::Ok, S::Error> {
+                let mut seq = serializer.serialize_seq(Some(self.bytes.len()))?;
+                for byte in self.bytes {
+                    self.visits.set(self.visits.get() + 1);
+                    seq.serialize_element(byte)?;
+                }
+                seq.end()
+            }
+        }
+        let visits = Cell::new(0);
+        let traced = Traced {
+            bytes: &[1; 4096],
+            visits: &visits,
+        };
+        let error = preflight_then_encode_plaintext(
+            &traced,
+            perp_core::clock::WIRE_MAGIC,
+            sealed_request_json_bytes(7).unwrap(),
+            || panic!("prefix refusal encoded"),
+        )
+        .unwrap_err();
+        assert!(matches!(error, ProverClientError::Http(_)));
+        assert_eq!(visits.get(), 0);
+        let error = preflight_then_encode_plaintext(
+            &traced,
+            &[],
+            sealed_request_json_bytes(32).unwrap(),
+            || panic!("count refusal encoded"),
+        )
+        .unwrap_err();
+        assert!(
+            matches!(error, ProverClientError::Http(ref message) if message == "HTTP request exceeds byte limit")
+        );
