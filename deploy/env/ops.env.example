# /etc/darkperp/ops.env — names only. Read by the notify, backup and monitor units.
# systemd reads EnvironmentFile= as root before dropping privileges, so
# root:root 0600 is enough.

# ntfy.sh topic for redacted ops events (letters, digits, dash, underscore).
FIN_ALERT_NTFY_TOPIC=

# Optional rsync destination for each new backup, e.g. backup@host:/srv/darkperp/
DARKPERP_BACKUP_OFFSITE=
# ssh command for that rsync, e.g. ssh -i /etc/darkperp/backup_ed25519 -o BatchMode=yes
RSYNC_RSH=
