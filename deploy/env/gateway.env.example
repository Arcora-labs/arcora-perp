# /etc/darkperp/gateway.env — names only. Fill values on the host, never in git.
# root:root 0600 (systemd reads it as root). DARKPERP_STATE, GATEWAY_BIND_ADDRESS and PORT
# are fixed in darkperp-gateway.service.

# --- Posture -------------------------------------------------------------
# 1 = strict production (refuses mock prover and dev overrides).
DARKPERP_PROD=

# --- L1 (setting L1_SETTLEMENT + L1_SEQUENCER_KEY enables production mode) --
L1_RPC=
L1_RPC_WITNESS=
L1_CHAIN_ID=
L1_SETTLEMENT=
L1_VAULT=
L1_USDC=
CLOCK_BOUND_VERIFIER=
# secret: sequencer key (must also be governance for finalSettle/finalExit)
L1_SEQUENCER_KEY=
# Separate signer for inclusion-challenge answers, on its own nonce lane (fund it
# with ETH for gas). Both paths are set together: a V3 keystore file and its
# password file (mode 0600). Its address must differ from the sequencer's. With
# an answer key set, stakes refunded to the sequencer are swept to it. Unset:
# answers use L1_SEQUENCER_KEY, with a warning at boot.
L1_ANSWER_KEYSTORE=
L1_ANSWER_PASSWORD_FILE=
# Deposit permit lifetime in seconds (launch value 1800). Bound in the release
# public config (release_manifest.py); at most livenessTimeoutBlocks * 2 / 8.
DEPOSIT_PERMIT_TTL_SECS=
# Bond top-up target, as the TVL (USDC base units) the bond should cover at 5 %
# (testnet launch value 1000000000000 = 1,000,000 USDC). Deposit capacity is
# about 20 x the posted bond.
L1_BOND_TARGET_TVL=
# Bond top-ups pause while the settlement's slashCount() is above this value.
# Acknowledge a slash here (survives restarts) or with
# POST /v1/admin/bond/acknowledge-slash {"slashCount": n} (until restart).
L1_BOND_ACKED_SLASH_COUNT=
# No deploy-block setting: challenges are read from the settlement's on-chain
# open set. deploy_clock_stack.py records the deploy and settlement blocks in
# <output>.deployment.json. Run the gateway and prover from the deploy block on:
# the settlement's liveness clock starts when it is created.

# --- Keys (secrets; move with backups, see docs/RECOVERY_RESTORE.md) -------
# Seals snapshot + journal and is the enclave signer.
ENCLAVE_SEED=
ORACLE_SIGNER_KEY=
# Set explicitly: production refuses to boot without it (or with the public
# demo key); only the demo posture falls back to the demo key.
GATEWAY_SIGNER_KEY=
FIN_ADMIN_KEY=
INSURANCE_OPERATOR_ADDRESS=

# --- Prover ----------------------------------------------------------------
PROVER_URL=
PROVER_SEAL_ROOT=
PROVER_TIMEOUT_SECS=
GATEWAY_EXPECTED_MEASUREMENT=
PROVER_EXPECTED_MEASUREMENT=
# Optional (64 hex): the guest ELF hash the HTTP prover must report before a
# window registers. Checked only with DARKPERP_PROD=1.
PROVER_EXPECTED_ELF_SHA256=

# --- Attestation -------------------------------------------------------------
ATTESTATION_DIR=
ATTESTATION_EXPECTED_MEASUREMENT=

# --- Restore (set only for a restore boot; values from a backup manifest) ----
DARKPERP_REQUIRE_RESTORE=
DARKPERP_RESTORE_SHA256=
DARKPERP_RESTORE_JOURNAL=

# --- HTTP / WebSocket service policy ----------------------------------------
GATEWAY_ALLOWED_ORIGINS=
GATEWAY_HTTP_MAX_BODY_BYTES=
GATEWAY_HTTP_MAX_IN_FLIGHT=
GATEWAY_HTTP_MAX_IN_FLIGHT_PER_CLIENT=
GATEWAY_WS_MAX_CONNECTIONS=

# --- In-process alerts (same topic as /etc/darkperp/ops.env) ----------------
FIN_ALERT_NTFY_TOPIC=
FIN_HELD_THRESHOLD=
FIN_BACKOFF_CAP_SECS=
